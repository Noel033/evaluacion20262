@model evaluacion20262.Models.SolicitudServicio
@{
    ViewData["Title"] = "Registrar Solicitud de Servicio";
}

<h2>Registrar Nueva Solicitud de Servicio</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Cliente" class="form-label">Cliente</label>
                <input asp-for="Cliente" class="form-control" placeholder="Nombre del cliente" />
                <span asp-validation-for="Cliente" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Telefono" class="form-label">Teléfono</label>
                <input asp-for="Telefono" class="form-control" placeholder="Número de teléfono" />
                <span asp-validation-for="Telefono" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Distrito" class="form-label">Distrito</label>
                <input asp-for="Distrito" class="form-control" placeholder="Distrito" />
                <span asp-validation-for="Distrito" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TipoServicio" class="form-label">Tipo de Servicio</label>
                <select asp-for="TipoServicio" class="form-select">
                    <option value="">-- Seleccione --</option>
                    <option value="Instalación">Instalación</option>
                    <option value="Mantenimiento">Mantenimiento</option>
                    <option value="Revisión">Revisión</option>
                    <option value="Fuga">Fuga</option>
                </select>
                <span asp-validation-for="TipoServicio" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label">Descripción</label>
                <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Descripción del servicio (opcional)"></textarea>
            </div>

            <button type="submit" class="btn btn-primary">Registrar Solicitud</button>
            <a asp-action="Index" class="btn btn-secondary">Volver al Listado</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
