@model IEnumerable<evaluacion20262.Models.SolicitudServicio>
@{
    ViewData["Title"] = "Listado de Solicitudes";
}

<h2>Listado de Solicitudes de Servicio</h2>
<hr />

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Nueva Solicitud</a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay solicitudes registradas.</div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Cliente</th>
                <th>Teléfono</th>
                <th>Distrito</th>
                <th>Tipo de Servicio</th>
                <th>Descripción</th>
                <th>Fecha de Registro</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Cliente</td>
                    <td>@item.Telefono</td>
                    <td>@item.Distrito</td>
                    <td>@item.TipoServicio</td>
                    <td>@item.Descripcion</td>
                    <td>@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}
